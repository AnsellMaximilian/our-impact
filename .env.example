# Core Supabase application (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Independent application secrets (required; generate a different random value for each)
VOTE_HASH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-32-byte-secret
DEVELOPER_SIGNING_SECRET=replace-with-a-different-random-32-byte-secret

# PayPal Sandbox (required only for recipient onboarding and payment tests)
PAYPAL_SANDBOX_CLIENT_ID=your-paypal-sandbox-rest-app-client-id
PAYPAL_SANDBOX_CLIENT_SECRET=your-paypal-sandbox-rest-app-secret
PAYPAL_SANDBOX_WEBHOOK_ID=your-paypal-sandbox-webhook-id
PAYPAL_SANDBOX_PARTNER_MERCHANT_ID=your-platform-sandbox-merchant-id
PAYPAL_PARTNER_ATTRIBUTION_ID=your-paypal-build-notation-code

# OpenRouter (required only for AI-assisted entitlements and impact-report drafts)
OPENROUTER_API_KEY=sk-or-v1-your-server-only-key
OPENROUTER_MODEL=your-structured-output-model-slug
