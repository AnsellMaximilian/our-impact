{
  "name": "@our-impact/browser",
  "version": "0.2.0",
  "description": "Browser SDK for embedding Our Impact campaigns and checking supporter entitlements.",
  "keywords": [
    "our-impact",
    "entitlements",
    "donations",
    "campaign-widget"
  ],
  "homepage": "https://our-impact.vercel.app/developers/docs",
  "bugs": {
    "url": "https://github.com/AnsellMaximilian/our-impact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnsellMaximilian/our-impact.git",
    "directory": "packages/browser"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
